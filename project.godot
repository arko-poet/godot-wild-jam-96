; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GTA VI"
config/version="0.1.0"
config/tags=PackedStringArray("jam")
run/main_scene="res://template/scenes/opening/opening.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://b8wr0hwoqop4v"

[autoload]

AppConfig="*uid://cjke6crjg14a0"
SceneLoader="*uid://cbwmrnp0af35y"
ProjectMusicController="*uid://r5t485lr3p7t"
ProjectUISoundController="*uid://cc37235kj4384"
Event="*uid://ddkyaotj0gt16"
TowerUpgradeManager="*uid://cskwn53bpq81w"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/maaacks_game_template/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://game/": "red",
"res://game/assets/": "purple",
"res://game/assets/art/": "purple",
"res://game/assets/audio/": "purple",
"res://game/autoloads/": "yellow",
"res://game/system/": "orange"
}

[global_group]

ectoplasm_lable="UI Ectoplasm Img"

[gui]

timers/tooltip_delay_sec=0.1
theme/custom="res://template/resources/themes/lore.tres"
theme/custom_font="uid://dbpq11kg7v055"

[internationalization]

locale/translations=PackedStringArray("res://addons/maaacks_game_template/base/translations/menus_translations.en.translation", "res://addons/maaacks_game_template/base/translations/menus_translations.fr.translation")

[maaacks_game_template]

disable_install_audio_busses=true
disable_update_check=false
disable_install_wizard=true
copy_path="res://template/"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
